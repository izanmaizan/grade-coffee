# ============================================
# Frontend Environment (TEMPLATE) — salin ke .env
# ============================================
# Saat development biarkan kosong agar memakai Vite proxy.
# Saat production isi sesuai domain backend.

# Base URL API. Default '/api/v1' (lewat proxy dev).
# Production contoh: https://api.domain.com/api/v1
VITE_API_BASE_URL=

# Origin backend untuk URL gambar hasil (/uploads/...).
# Kosongkan jika frontend & backend satu origin. Production contoh:
# https://api.domain.com
VITE_UPLOADS_BASE_URL=

# Target proxy dev (opsional). Default http://localhost:8000
VITE_PROXY_TARGET=
