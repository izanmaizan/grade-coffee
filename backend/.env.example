# ============================================
# Green Bean Grading - Backend Environment (TEMPLATE)
# ============================================
# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
#   cp .env.example .env
# JANGAN commit file `.env` (sudah masuk .gitignore).

# Environment: development | production
APP_ENV=development

# ---- Database (MySQL) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=green_bean_user
DB_PASSWORD=CHANGE_ME            # WAJIB diisi di production
DB_NAME=green_bean_grading

# ---- Connection Pool ----
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_RETRIES=5

# ---- Model YOLO ----
MODEL_PATH=weights/best.pt
INFERENCE_TIMEOUT_SECONDS=30
# REQUIRE_MODEL_ON_STARTUP=true

# ---- Upload & Storage ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
IMAGE_COMPRESS_ENABLED=true
IMAGE_MAX_DIMENSION=1920
IMAGE_JPEG_QUALITY=85
UPLOAD_RETENTION_DAYS=30
DISK_USAGE_WARN_PERCENT=90

# ---- CORS & Security ----
CORS_ORIGINS=https://your-domain.com
MAX_REQUEST_BODY_MB=15
FORCE_HTTPS=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_ANALYZE=10/minute

# ---- Detection Thresholds ----
CONFIDENCE_THRESHOLD=0.05
IOU_THRESHOLD=0.3
DEVICE=auto

# ---- Grading ----
# Berat sampel acuan normalisasi nilai cacat: SNI=300, SCA Arabika=350
DEFECT_REFERENCE_GRAM=300

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FORMAT=json
